# --- Application ---
NODE_ENV=production
PORT=5000
SESSION_SECRET=change-me
# Set to "false" when the app is served over plain HTTP (no TLS)
SESSION_COOKIE_SECURE=false

# --- Yandex Cloud Foundation Models (YandexGPT) ---
YANDEX_API_KEY=
YANDEX_CATALOG_ID=

# --- Yandex Cloud Object Storage (same bucket as the original service) ---
YANDEX_S3_ACCESS_KEY_ID=
YANDEX_S3_SECRET_ACCESS_KEY=
YANDEX_S3_BUCKET=cinefeels

# --- Qdrant ---
QDRANT_HOST=http://qdrant:6333
QDRANT_COLLECTION=movie_embeddings

# --- EASE FastAPI service ---
EASE_SERVICE_URL=http://ease:6334
# The EASE service runs in its own container in production
START_EASE_SERVICE=false

# --- PostgreSQL ---
POSTGRES_USER=mediavibe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mediavibe
DATABASE_URL=postgres://mediavibe:change-me@postgres:5432/mediavibe
